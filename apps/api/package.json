{
  "name": "@bookwise/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema ../../prisma/schema.prisma",
    "db:push": "prisma db push --schema ../../prisma/schema.prisma",
    "build": "pnpm db:generate && tsc",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "lint": "pnpm db:generate && tsc --noEmit",
    "test": "pnpm db:generate && NODE_ENV=test tsx --test src/server.test.ts"
  },
  "dependencies": {
    "@bookwise/shared": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@prisma/client": "^6",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prisma": "^6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}