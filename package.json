{
  "name": "bookwise-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @bookwise/api --filter @bookwise/web dev",
    "dev:web": "pnpm --filter @bookwise/web dev",
    "dev:api": "pnpm --filter @bookwise/api dev",
    "test": "pnpm --filter @bookwise/api test",
    "db:generate": "pnpm --filter @bookwise/api db:generate",
    "db:migrate": "pnpm --filter @bookwise/api db:migrate",
    "build": "pnpm --filter @bookwise/shared --filter @bookwise/api --filter @bookwise/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6"
  }
}